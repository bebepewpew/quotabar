#!/usr/bin/env zsh
set -euo pipefail

project_dir="${0:A:h}"
cd "$project_dir"

platform="$(uname -s)"
swift_image="${QUOTABAR_SWIFT_IMAGE:-swift:6.3-noble}"

if [[ "$platform" == "Darwin" ]]; then
  # Some Command Line Tools updates temporarily pair a newer compiler with an
  # incompatible newest SDK. The 15.4 SDK remains compatible with QuotaBar's
  # macOS 14 deployment target and avoids that toolchain mismatch.
  compatible_sdk="/Library/Developer/CommandLineTools/SDKs/MacOSX15.4.sdk"
  if [[ -d "$compatible_sdk" ]]; then
    export SDKROOT="$compatible_sdk"
  fi
fi

task_cache="${TMPDIR:-/tmp}/quotabar-swift-cache"
clang_cache="${TMPDIR:-/tmp}/quotabar-clang-cache"
mkdir -p "$task_cache" "$clang_cache"
export SWIFTPM_MODULECACHE_OVERRIDE="$task_cache"
export CLANG_MODULE_CACHE_PATH="$clang_cache"

action="${1:-run}"
if (( $# > 0 )); then shift; fi

have() { command -v "$1" >/dev/null 2>&1 }

# Distributions without an official Swift package (Arch among them) can build
# through the upstream container instead. --user keeps .build owned by you.
docker_run() {
  docker run --rm \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp \
    -v "$project_dir":/workspace \
    -w /workspace \
    "$swift_image" "$@"
}

docker_swift() { docker_run swift "$@" }

# Where a suite run has to happen on macOS. True when full Xcode is installed
# and the host toolchain can run it; false when it cannot but docker can, so the
# caller falls through to the container; exit 2 when neither is available.
#
# A Command Line Tools installation ships neither XCTest nor Swift Testing, but
# the container the Linux branch already uses runs everything that is not the
# app: Package.swift declares the QuotaBar target behind `#if os(macOS)`, so the
# Linux image cannot build it at all. Say that before running, or a green run
# reads as a full one.
use_host_toolchain_for_suite() {
  if [[ -x /Applications/Xcode.app/Contents/Developer/usr/bin/xcodebuild ]]; then
    return 0
  fi
  if have docker; then
    print -u2 "Full Xcode is unavailable; running the suite in $swift_image through docker."
    print -u2 "That covers QuotaCore, QuotaTray and the CLI. The QuotaBar macOS app target"
    print -u2 "is not in that image, so a pass here is not a pass for the app."
    return 1
  fi
  print -u2 "QuotaBar tests require the full Xcode toolchain (this Command Line Tools installation includes neither XCTest nor Swift Testing)."
  exit 2
}

build_app() {
  swift build "$@" >&2
  local bin_dir app_dir
  bin_dir="$(swift build --show-bin-path)"
  app_dir="$project_dir/.build/QuotaBar.app"
  mkdir -p "$app_dir/Contents/MacOS" "$app_dir/Contents/Resources"
  cp "$bin_dir/QuotaBar" "$app_dir/Contents/MacOS/QuotaBar"
  cp "$project_dir/Resources/Info.plist" "$app_dir/Contents/Info.plist"
  cp "$project_dir/Resources/AppIcon.icns" "$app_dir/Contents/Resources/AppIcon.icns"
  /usr/bin/codesign --force --sign - "$app_dir" >/dev/null
  print "$app_dir"
}

usage() {
  print -u2 "Usage: ./quotabar [run|build|test|coverage|cli] [SwiftPM options]"
  print -u2 ""
  print -u2 "  run       macOS: build and launch the menu-bar app"
  print -u2 "            Linux: run the quotabar CLI"
  print -u2 "  build     compile everything this platform supports"
  print -u2 "  test      run the test suite"
  print -u2 "  coverage  run the suite with coverage and print the report"
  print -u2 "            (--lcov FILE also writes lcov, relative to the repo)"
  print -u2 "  cli       run the quotabar CLI (all platforms)"
  print -u2 ""
  print -u2 "Without a usable local toolchain -- Linux without Swift, or macOS without"
  print -u2 "full Xcode for test and coverage -- \$QUOTABAR_SWIFT_IMAGE (default"
  print -u2 "$swift_image) is used through docker. That image has no macOS app target."
  exit 2
}

case "$platform" in
  Darwin)
    case "$action" in
      run)
        app_dir="$(build_app "$@")"
        # Launch the bundle through Launch Services so macOS assigns the process its
        # bundle identity. Running the inner Mach-O directly makes UserNotifications
        # treat QuotaBar as an unsupported command-line executable.
        lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
        "$lsregister" -f "$app_dir"
        # QuotaBar is a resident LSUIElement agent, so `open` would find the
        # previous instance and merely reactivate it, leaving the freshly built
        # binary unused. `-n` would start a second one instead, giving two menu
        # bar icons; replacing the running instance is what a rebuild wants.
        /usr/bin/pkill -x QuotaBar 2>/dev/null || true
        exec /usr/bin/open -W "$app_dir"
        ;;
      build) build_app "$@" ;;
      cli) exec swift run quotabar "$@" ;;
      test)
        if use_host_toolchain_for_suite; then
          exec swift test "$@"
        fi
        exec docker_swift test "$@"
        ;;
      coverage)
        if use_host_toolchain_for_suite; then
          exec "$project_dir/scripts/coverage" "$@"
        fi
        # As on Linux: llvm-cov has to be the toolchain that wrote the profile,
        # so the whole script runs in the container and the paths it is given,
        # --lcov included, are container paths under /workspace.
        exec docker_run ./scripts/coverage "$@"
        ;;
      *) usage ;;
    esac
    ;;
  Linux)
    if have swift; then
      case "$action" in
        run|cli) exec swift run quotabar "$@" ;;
        build) exec swift build "$@" ;;
        test) exec swift test "$@" ;;
        coverage) exec "$project_dir/scripts/coverage" "$@" ;;
        *) usage ;;
      esac
    elif have docker; then
      case "$action" in
        build) exec docker_swift build "$@" ;;
        test) exec docker_swift test "$@" ;;
        # llvm-cov has to read the profile with the toolchain that wrote it, so
        # the whole script runs in the container rather than just `swift test`.
        # Paths it is given, --lcov included, are container paths under
        # /workspace: keep them relative to the repository.
        coverage) exec docker_run ./scripts/coverage "$@" ;;
        run|cli)
          # The probes shell out to gemini/claude and notifications need the
          # session bus, so the CLI itself has to run on the host. Build a
          # statically linked binary in the container, then execute it here.
          #
          # Release only: a debug --static-swift-stdlib link fails on missing ICU
          # symbols, which release builds drop as dead code.
          docker_swift build -c release --static-swift-stdlib >&2
          exec "$project_dir/.build/release/quotabar" "$@"
          ;;
        *) usage ;;
      esac
    else
      print -u2 "No Swift toolchain and no docker found."
      print -u2 "Install Swift from https://swift.org/install, or install docker to build in $swift_image."
      exit 2
    fi
    ;;
  *)
    print -u2 "QuotaBar has no build recipe for $platform. Try 'swift build' directly."
    exit 2
    ;;
esac
