#!/bin/sh
set -eu

# Codex discovers skills only under $CODEX_HOME/skills; unlike Claude Code it
# does not read them from the repository. So the skills are versioned here and
# copied into place, the same way scripts/install-hooks wires up .githooks.
# Re-run after pulling changes.

repo_root=$(git rev-parse --show-toplevel)
codex_home=${CODEX_HOME:-$HOME/.codex}
dest="$codex_home/skills"
marker=.quotabar-managed

mkdir -p "$dest"

for source in "$repo_root"/.codex/skills/*/; do
    [ -d "$source" ] || continue
    name=$(basename "$source")
    target="$dest/$name"

    # Never clobber a skill this script did not install.
    if [ -e "$target" ] && [ ! -f "$target/$marker" ]; then
        printf '%s\n' "Refusing to replace $target: it was not installed by this script." >&2
        printf '%s\n' "Move it aside and re-run if you want the QuotaBar version." >&2
        exit 1
    fi

    rm -rf "$target"
    cp -R "$source" "$target"
    printf '%s\n' "QuotaBar" > "$target/$marker"
    printf '%s\n' "installed $name -> $target"
done

# A skill renamed or dropped in the repository leaves its old directory behind,
# and Codex would go on offering both — one role under two names. Prune only
# what this script installed; anything without the marker is somebody else's.
for target in "$dest"/*/; do
    [ -d "$target" ] || continue
    name=$(basename "$target")
    [ -f "$target/$marker" ] || continue
    if [ -d "$repo_root/.codex/skills/$name" ]; then
        continue
    fi
    rm -rf "$target"
    printf '%s\n' "removed $name (no longer in the repository)"
done

printf '%s\n' "Codex skills installed. They point at docs/agent-guides/ in the repo."
