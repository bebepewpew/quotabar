#!/bin/sh
set -eu

# Run several independent QuotaBar tasks at once, each in its own git worktree,
# and open a pull request for every one that passes the AGENTS.md gate.
#
# Codex has no workflow engine, so this is the shell equivalent of
# .claude/workflows/parallel-tasks.js. Codex edits code inside its worktree under
# the workspace-write sandbox; this script runs the build, the tests and
# git diff --check itself, so the gate is enforced rather than self-reported.
#
#   scripts/codex-parallel "add a KDE tray icon" "cache provider discovery"
#   scripts/codex-parallel --label tooling "teach the runner to label its PRs"
#   scripts/codex-parallel --clean          # remove the worktrees it created
#
# Every pull request needs exactly one category label or the Labels CI job fails
# it, so each agent is asked to end its report with a PR-LABEL: line and a
# PR-TITLE: changelog line. --label <category> supplies the label for a task
# whose agent named none. A branch still left without one is pushed and reported
# as label-missing rather than opened unlabelled.
#
# QUOTABAR_CODEX_APPROVE=1 adds --approve-for-me, letting Codex proceed without
# stopping for approval. Off by default: unattended auto-approval is your call.

usage() {
    sed -n '3,23p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
}

slug_of() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
        | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//' | cut -c1-40
}

# Exactly the category labels the Labels job in .github/workflows/ci.yml
# accepts; that array is the one that fails a pull request, so it is the one
# this list has to track. Prints the canonical spelling of a label it
# recognises and fails for anything else. What it prints is the matched
# literal and never its argument, so nothing an agent wrote can reach `gh`
# as an option of its own.
canonical_label() {
    normalised=$(printf '%s' "${1:-}" | tr -d '[:cntrl:]' | tr '[:upper:]' '[:lower:]' \
        | sed -e "s/[\`\"'*]//g" -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
              -e 's/[[:space:]][[:space:]]*/ /g')
    case "$normalised" in
        feature)          printf '%s' feature ;;
        fix)              printf '%s' fix ;;
        security)         printf '%s' security ;;
        performance)      printf '%s' performance ;;
        tooling)          printf '%s' tooling ;;
        ci)               printf '%s' ci ;;
        documentation)    printf '%s' documentation ;;
        docs)             printf '%s' docs ;;
        dependencies)     printf '%s' dependencies ;;
        "skip changelog"|skip-changelog)
                          printf '%s' "skip changelog" ;;
        *) return 1 ;;
    esac
}

# The category label the agent asked for in $1, its final message. The last
# PR-LABEL: line wins, because an agent that corrects itself does so later in
# the message. Fails when the file is missing, names no label, or names one
# the Labels job would reject.
label_from() {
    [ -f "${1:-}" ] || return 1
    canonical_label "$(sed -n 's/^[[:space:]]*PR-LABEL:[[:space:]]*//p' "$1" | tail -1)"
}

# The category label to open the pull request with: the agent's choice in the
# report $1, else the caller's --label in $2 for a task whose agent named none,
# else nothing -- which is not a failure here, but a pull request that must not
# be opened. Prints the empty string in that case and still succeeds, so a task
# is reported rather than abandoned mid-way by set -e.
label_for() {
    label_from "${1:-}" || canonical_label "${2:-}" || printf '%s' ''
}

# The changelog line for the pull request: the agent's PR-TITLE: from $1, or
# the caller's task phrasing in $2 when it named none. Squash-merge makes this
# the commit subject on main and the release-notes entry, which is why the raw
# task text is the fallback rather than the default. Control characters go, runs
# of whitespace collapse, and an over-long line is cut -- a terminal escape or a
# paragraph would otherwise become the changelog.
title_from() {
    title=""
    if [ -f "${1:-}" ]; then
        title=$(sed -n 's/^[[:space:]]*PR-TITLE:[[:space:]]*//p' "$1" | tail -1)
    fi
    [ -n "$title" ] || title=${2:-}
    printf '%s' "$title" | tr -d '[:cntrl:]' \
        | sed -e 's/^[[:space:]-]*//' -e 's/[[:space:]]*$//' \
              -e 's/[[:space:]][[:space:]]*/ /g' -e 's/^\(.\{72\}\).\{1,\}$/\1/'
}

prompt_for() {
    cat <<PROMPT
You are implementing ONE task in the QuotaBar repository, in a git worktree of
your own. Another agent is doing a different task at the same time in a different
worktree, so stay strictly inside this one.

TASK: $1

Read AGENTS.md first. It is the canonical policy and it binds you: never push to
main, treat CLI output as untrusted, keep external processes bounded and terminate
their complete process groups, keep persisted decoding backward compatible, and
add fixtures for any parser change.

Make the change and add or update the tests it needs. Keep it to this task only —
if you notice something else wrong, say so in your final message rather than
fixing it here.

Do NOT commit, push, or open a pull request, and do not run the build or the test
suite: the script that started you runs the gate itself and handles git. Just
leave the working tree in the state you want reviewed, and finish with a short
summary of what you changed and anything you deliberately left out.

End that summary with exactly these two lines, each on its own line:

PR-TITLE: one imperative line describing the change
PR-LABEL: one of feature, fix, security, performance, tooling, ci, documentation, dependencies, skip changelog

The repository squash-merges, so PR-TITLE becomes the commit subject on main and
the line in the release notes: write it for someone reading the release, not for
someone reading the diff, and keep it under about 70 characters. PR-LABEL decides
which section of the notes the change lands in, and CI fails a pull request that
does not carry exactly one of those labels, so choose by what the change actually
is: tooling for agent runners, scripts and developer workflow, and skip changelog
for a change nobody reading the release needs to know about. Without a valid
PR-LABEL the branch is pushed but no pull request is opened.
PROMPT
}

# Open the pull request, or refuse to. An unlabelled pull request fails the
# Labels job the moment it is opened, so a branch with no category label is
# reported instead: the work is finished and pushed, and only the label is
# missing. $1 branch, $2 worktree, $3 label, $4 title, $5 body, $6 log, $7 status.
publish_task() {
    if [ -z "$3" ]; then
        printf 'label-missing\t%s\t%s\n' "$1" \
            "pushed, but no category label was chosen; do not re-run it, open it with: gh pr create --base main --head $1 --label <category>" \
            > "$7"
        return 0
    fi

    url=$(cd "$2" && gh pr create --base main --title "$4" --body "$5" --label "$3" \
        2>>"$6" | tail -1 | tr -d '[:cntrl:]') || url=""
    if [ -n "$url" ]; then
        printf 'opened\t%s\t%s\n' "$1" "$url ($3)" > "$7"
    else
        printf 'pr-failed\t%s\t%s\n' "$1" "pushed, but gh pr create failed; see $6" > "$7"
    fi
}

run_task() {
    task=$1
    slug=$2
    branch="codex/$slug"
    worktree="$worktrees_root/$slug"
    status="$run_dir/$slug.status"
    report="$run_dir/$slug.last"

    if ! git -C "$repo_root" worktree add --quiet -b "$branch" "$worktree" origin/main 2>"$run_dir/$slug.err"; then
        printf 'worktree-failed\t%s\t%s\n' "$branch" "$(tr -d '\n' < "$run_dir/$slug.err")" > "$status"
        return 0
    fi

    if ! codex exec -C "$worktree" -s workspace-write $approve \
            -o "$report" "$(prompt_for "$task")" \
            > "$run_dir/$slug.log" 2>&1; then
        printf 'codex-failed\t%s\tsee %s\n' "$branch" "$run_dir/$slug.log" > "$status"
        return 0
    fi
    # An agent that finished without writing a final message still has to reach
    # the label decision below rather than dying on a missing file.
    [ -f "$report" ] || : > "$report"

    if [ -z "$(git -C "$worktree" status --porcelain)" ]; then
        printf 'no-changes\t%s\tCodex left the tree unchanged\n' "$branch" > "$status"
        return 0
    fi

    # The gate, run here rather than trusted from the agent.
    if ! ( cd "$worktree" && ./quotabar build && ./quotabar test && git diff --check ) \
            >> "$run_dir/$slug.log" 2>&1; then
        printf 'gate-failed\t%s\tworktree kept at %s\n' "$branch" "$worktree" > "$status"
        return 0
    fi

    label=$(label_for "$report" "$default_label")
    title=$(title_from "$report" "$task")
    [ -n "$title" ] || title=$task

    git -C "$worktree" add -- . >/dev/null
    git -C "$worktree" commit --quiet -m "$title" >/dev/null 2>&1 || true
    if ! git -C "$worktree" push --quiet -u origin "$branch" >>"$run_dir/$slug.log" 2>&1; then
        printf 'push-failed\t%s\tsee %s\n' "$branch" "$run_dir/$slug.log" > "$status"
        return 0
    fi

    body="## Summary

$task

$(sed -e '/^[[:space:]]*PR-TITLE:/d' -e '/^[[:space:]]*PR-LABEL:/d' "$report" 2>/dev/null || true)

## Validation

- [x] \`./quotabar build\`
- [x] \`./quotabar test\`
- [x] \`git diff --check\`

Run by scripts/codex-parallel, which executed the gate itself rather than taking
the agent's word for it. On Linux the suite covers QuotaCore and the CLI; the
macOS app is covered by CI only.

## Notes

Written by Codex in an isolated worktree. Review before merging."

    publish_task "$branch" "$worktree" "$label" "$title" "$body" "$run_dir/$slug.log" "$status"
}

# scripts/test-codex-parallel sources this file with this set, to exercise the
# helpers above without running anything. Everything below has side effects.
if [ "${QUOTABAR_CODEX_PARALLEL_LIB:-0}" = "1" ]; then
    return 0
fi

clean=0
default_label=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --clean) clean=1; shift ;;
        --label) [ "$#" -ge 2 ] || usage; default_label=$2; shift 2 ;;
        --label=*) default_label=${1#--label=}; shift ;;
        -h|--help) usage ;;
        --) shift; break ;;
        -?*) printf '%s\n' "unknown option: $1" >&2; usage ;;
        *) break ;;
    esac
done

if [ -n "$default_label" ] && ! default_label=$(canonical_label "$default_label"); then
    printf '%s\n' "--label must be one of: feature, fix, security, performance, tooling, ci, documentation, docs, dependencies, \"skip changelog\"" >&2
    exit 2
fi

repo_root=$(git rev-parse --show-toplevel)
worktrees_root="$(dirname "$repo_root")/quotabar-worktrees"
run_dir="$worktrees_root/.runs"

if [ "$clean" = 1 ]; then
    for path in "$worktrees_root"/*; do
        [ -d "$path" ] || continue
        case "$path" in *"/.runs") continue ;; esac
        slug=$(basename "$path")
        git -C "$repo_root" worktree remove --force "$path" 2>/dev/null || rm -rf "$path"
        printf '%s\n' "removed $path"
        # -d refuses unmerged work, which is what we want: a task branch nobody
        # merged yet is kept and reported rather than silently discarded.
        if git -C "$repo_root" show-ref --quiet "refs/heads/codex/$slug"; then
            if git -C "$repo_root" branch -d "codex/$slug" >/dev/null 2>&1; then
                printf '%s\n' "  deleted branch codex/$slug"
            else
                printf '%s\n' "  kept branch codex/$slug (unmerged work)"
            fi
        fi
    done
    git -C "$repo_root" worktree prune
    rm -rf "$run_dir"
    printf '%s\n' "done"
    exit 0
fi

[ "$#" -gt 0 ] || usage
command -v codex >/dev/null || { printf '%s\n' "codex is not installed" >&2; exit 1; }

approve=""
[ "${QUOTABAR_CODEX_APPROVE:-0}" = "1" ] && approve="--approve-for-me"

mkdir -p "$run_dir"
git -C "$repo_root" fetch --quiet origin main

count=0
for task in "$@"; do
    slug=$(slug_of "$task")
    [ -n "$slug" ] || { printf '%s\n' "skipping unnamed task" >&2; continue; }
    count=$((count + 1))
    printf '%s\n' "starting: $task  ->  $worktrees_root/$slug"
    run_task "$task" "$slug" &
done

[ "$count" -gt 0 ] || { printf '%s\n' "nothing to do" >&2; exit 2; }
wait

printf '\n%s\n' "--- results ---"
failed=0
for status in "$run_dir"/*.status; do
    [ -f "$status" ] || continue
    state=$(cut -f1 "$status")
    printf '%s\n' "$(cut -f1,2,3 "$status" | tr '\t' ' ')"
    [ "$state" = "opened" ] || failed=1
done
printf '%s\n' "worktrees kept under $worktrees_root (scripts/codex-parallel --clean removes them)"
exit "$failed"
